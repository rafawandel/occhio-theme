  "tokenColors": [
    {
      "name": "Comentarios",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6787a2",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Palavras-chave",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.other.DML.sql",
        "keyword.other.DDL.sql",
        "keyword.other.sql"
      ],
      "settings": {
        "foreground": "#00d4ff"
      }
    },
    {
      "name": "Operadores",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "keyword.operator.comparison",
        "keyword.operator.arithmetic"
      ],
      "settings": {
        "foreground": "#7f9bb3"
      }
    },
    {
      "name": "Operadores logicos em texto",
      "scope": [
        "keyword.operator.logical.python",
        "keyword.operator.word",
        "keyword.operator.new",
        "keyword.operator.expression"
      ],
      "settings": {
        "foreground": "#00d4ff"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#00e676"
      }
    },
    {
      "name": "Escapes e placeholders",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder",
        "constant.character.format.placeholder",
        "punctuation.definition.template-expression",
        "punctuation.section.embedded"
      ],
      "settings": {
        "foreground": "#ffb300"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7ee8fa"
      }
    },
    {
      "name": "Numeros e constantes",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.language.boolean",
        "support.constant",
        "constant.other"
      ],
      "settings": {
        "foreground": "#ffb300"
      }
    },
    {
      "name": "Constantes em maiusculas",
      "scope": [
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#ffb300"
      }
    },
    {
      "name": "Funcoes",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function",
        "support.function.builtin"
      ],
      "settings": {
        "foreground": "#7ee8fa"
      }
    },
    {
      "name": "Tipos e classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type",
        "entity.other.inherited-class",
        "entity.name.namespace",
        "entity.name.type.module"
      ],
      "settings": {
        "foreground": "#4da3ff"
      }
    },
    {
      "name": "self e this",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special.self.python"
      ],
      "settings": {
        "foreground": "#b39dff",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Parametros",
      "scope": [
        "variable.parameter",
        "meta.function.parameters variable"
      ],
      "settings": {
        "foreground": "#9fb8cc",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variaveis",
      "scope": [
        "variable",
        "variable.other",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#c8d8e8"
      }
    },
    {
      "name": "Propriedades",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#a8c7e0"
      }
    },
    {
      "name": "Decorators e anotacoes",
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator",
        "storage.type.annotation"
      ],
      "settings": {
        "foreground": "#ffb300"
      }
    },
    {
      "name": "Pontuacao",
      "scope": [
        "punctuation",
